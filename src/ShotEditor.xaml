<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Arial, Microsoft YaHei UI" FontSize="12" Foreground="#19212B" Background="#F7F7F8" Focusable="True">
 <UserControl.Resources><Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,4"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E6EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>
 <Border BorderBrush="#DEE2E8" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions>
 <Grid x:Name="TitleBar" Background="White"><TextBlock x:Name="FileName" Text="截图与标注" Margin="18,0,100,0" VerticalAlignment="Center" FontSize="11" Foreground="#68717D" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Min" Width="40" Margin="0" Padding="10" BorderThickness="0"><Path Data="M0,4 L12,4" Stroke="#68717D"/></Button><Button x:Name="Close" Width="40" Margin="0" Padding="10" BorderThickness="0"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#68717D"/></Button></StackPanel></Grid>
 <Border Grid.Row="1" Background="White" BorderBrush="#E3E6EB" BorderThickness="0,1,0,1" Padding="16,10,10,6"><WrapPanel x:Name="Tools"/></Border>
 <Grid Grid.Row="2" Margin="16,12"><ScrollViewer x:Name="ImageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><StackPanel x:Name="Surface" HorizontalAlignment="Center" VerticalAlignment="Center"><Image x:Name="ShotImage" Stretch="None" Focusable="True"/></StackPanel></ScrollViewer></Grid>
 <Border Grid.Row="3" Background="White" BorderBrush="#E3E6EB" BorderThickness="0,1,0,0" Padding="16,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="Previous" Content="← 上一张"/><Button x:Name="Next" Content="下一张 →"/><TextBlock x:Name="Counter" VerticalAlignment="Center" FontSize="11" Foreground="#68717D" Margin="4,0,12,4"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ZoomOut" Content="−"/><Button x:Name="Fit" Content="适应"/><Button x:Name="ZoomIn" Content="+"/><Button x:Name="Folder" Content="目录"/><Button x:Name="SaveShot" Content="保存"/><Button x:Name="PinShot" Content="悬浮贴图" Foreground="#002FA7"/><Button x:Name="CopyShot" Content="复制图片" Background="#002FA7" BorderBrush="#002FA7" Foreground="White" Margin="0,0,0,4"/></StackPanel><TextBlock x:Name="Note" Grid.Row="1" Grid.ColumnSpan="2" Text="截图自动保存" Foreground="#7A838F" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></Grid></Border>
 </Grid></Border>
</UserControl>
