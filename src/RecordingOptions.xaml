<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Arial, Microsoft YaHei UI" FontSize="13" Foreground="#19212B" Background="#FFFFFF">
<UserControl.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#F7F7F8"/><Setter Property="BorderBrush" Value="#E3E6EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="17" Height="17" CornerRadius="4" BorderBrush="#CCD1DA" BorderThickness="1" Background="White" VerticalAlignment="Center"><Path x:Name="Tick" Data="M3,8 L6,11 L12,5" Stroke="White" StrokeThickness="1.8" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#002FA7"/><Setter TargetName="Box" Property="BorderBrush" Value="#002FA7"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="11,10"/><Setter Property="BorderBrush" Value="#DEE2E8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="12,10"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DEE2E8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" Background="White" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="White" BorderBrush="#DEE2E8" BorderThickness="1" CornerRadius="5"><Path Data="M0,0 L5,5 L10,0" Stroke="#68717D" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,11,36,11" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="White" BorderBrush="#DEE2E8" BorderThickness="1" Padding="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><StackPanel IsItemsHost="True"/></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,9"/></Style>
</UserControl.Resources>
<Border BorderBrush="#DEE2E8" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid x:Name="TitleBar"><TextBlock Text="AI截图助手 / 屏幕录制" Margin="22,0,0,0" Foreground="#7A838F" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Min" Width="40" Padding="10" BorderThickness="0" Background="White"><Path Data="M0,4 L12,4" Stroke="#68717D"/></Button><Button x:Name="Close" Width="40" Padding="10" BorderThickness="0" Background="White"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#68717D"/></Button></StackPanel></Grid>
<Grid Grid.Row="1" Margin="30,15,30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="开始一次录制" FontSize="27" FontWeight="Bold"/><TextBlock Text="选择画面范围，记录你需要的声音。" FontSize="12" Foreground="#7A838F" Margin="0,9,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F7F7F8" BorderBrush="#E3E6EB" BorderThickness="1" Padding="12,7" CornerRadius="5"><TextBlock Text="MP4" Foreground="#002FA7" FontWeight="Bold" FontSize="11"/></Border></Grid>
<StackPanel Grid.Row="1"><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="录制范围" Foreground="#68717D" Margin="0,12,0,0"/><StackPanel Grid.Column="1"><ComboBox x:Name="Scope"><ComboBoxItem Content="框选区域"/><ComboBoxItem Content="全屏（所有显示器）"/></ComboBox><TextBlock x:Name="ScopeHint" FontSize="11" Foreground="#7A838F" Margin="0,8,0,0"/></StackPanel></Grid>
<Border BorderBrush="#E3E6EB" BorderThickness="0,1,0,1" Padding="0,18" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="声音" Foreground="#68717D" Margin="0,2,0,0"/><StackPanel Grid.Column="1"><CheckBox x:Name="Sound" Content="录制声音" FontWeight="Bold"/><StackPanel x:Name="Sources" Orientation="Horizontal" Margin="0,17,0,12"><CheckBox x:Name="SystemSound" Content="系统声音" Margin="0,0,30,0"/><CheckBox x:Name="Microphone" Content="麦克风"/></StackPanel><TextBlock Text="使用默认音频设备；关闭上方开关即可静音录制。" FontSize="11" Foreground="#7A838F" TextWrapping="Wrap"/></StackPanel></Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="保存位置" Foreground="#68717D" Margin="0,12,0,0"/><StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Directory" FontSize="11"/><Button x:Name="Browse" Content="浏览" Grid.Column="1" Margin="8,0,0,0" Padding="12,10"/></Grid><TextBlock Text="停止录制后自动保存，可随时修改目录。" FontSize="11" Foreground="#7A838F" Margin="0,8,0,0"/></StackPanel></Grid><TextBlock x:Name="Error" Foreground="#BF3545" FontSize="11" TextWrapping="Wrap" Margin="88,12,0,0"/></StackPanel>
<Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="Esc 取消" Foreground="#7A838F" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="取消" Margin="0,0,10,0"/><Button x:Name="Start" Content="开始录制" Background="#002FA7" BorderBrush="#002FA7" Foreground="White" Padding="24,11"/></StackPanel></Grid>
</Grid></Grid></Border></UserControl>
