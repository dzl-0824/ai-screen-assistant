<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Arial, Microsoft YaHei UI" Foreground="#19212B" Background="#FFFFFF" FontSize="12">
<UserControl.Resources><Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="15,9"/><Setter Property="Background" Value="#F7F7F8"/><Setter Property="Foreground" Value="#19212B"/><Setter Property="BorderBrush" Value="#E3E6EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>
<Border BorderBrush="#DEE2E8" BorderThickness="1" Padding="20,15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid x:Name="DragBar" Background="Transparent"><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" Background="#F7F7F8" CornerRadius="5" Margin="0,0,12,0"><Ellipse x:Name="Dot" Fill="#002FA7" Width="8" Height="8"/></Border><TextBlock x:Name="Elapsed" Text="00:00" FontSize="25" FontWeight="Bold"/><TextBlock Text="屏幕录制" Foreground="#7A838F" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid><TextBlock x:Name="Status" Grid.Row="1" Text="正在准备录制…" Foreground="#7A838F" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,14"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Pause" Content="暂停" IsEnabled="False"/><Button x:Name="Folder" Content="打开目录" Grid.Column="2" Margin="0,0,10,0" Visibility="Collapsed"/><Button x:Name="Stop" Grid.Column="3" Content="停止并保存" Background="#002FA7" Foreground="White" BorderBrush="#002FA7" IsEnabled="False"/></Grid></Grid></Border>
</UserControl>
