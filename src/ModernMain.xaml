      <Border BorderBrush="#E3E6EB" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,16,0,0"><TextBlock Text="仅将框选区域发送到模型服务；截图自动保存到你设置的本地目录。" FontSize="11" Foreground="#7A838F" TextWrapping="Wrap"/></Border>
     </StackPanel>
<StackPanel x:Name="MailPage" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="MailQQ" Content="QQ 邮箱" Padding="14,7"/><Button x:Name="Mail163" Content="163 邮箱" Padding="14,7" Margin="10,0,0,0"/></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="64"/><RowDefinition Height="64"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="发件邮箱" FontSize="11" Foreground="#68717D" Margin="0,0,0,6"/><TextBox x:Name="MailFrom" Padding="10,8" Height="36"/></StackPanel><StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="SMTP 授权码 · 本机加密" FontSize="11" Foreground="#68717D" Margin="0,0,0,6"/><PasswordBox x:Name="MailPassword" Padding="10,8" Height="36" BorderBrush="#E3E6EB"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="SMTP 服务器" FontSize="11" Foreground="#68717D" Margin="0,0,0,6"/><TextBox x:Name="MailHost" Padding="10,8" Height="36"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="端口" FontSize="11" Foreground="#68717D" Margin="0,0,0,6"/><TextBox x:Name="MailPort" Padding="10,8" Height="36"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="邮件主题" FontSize="11" Foreground="#68717D" Margin="0,0,0,6"/><TextBox x:Name="MailSubject" Padding="10,8" Height="36"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="连接加密" FontSize="11" Foreground="#68717D" Margin="0,0,0,6"/><ComboBox x:Name="MailSecurity" Padding="8,6" Height="36"><ComboBoxItem Content="SSL / TLS（465）"/><ComboBoxItem Content="STARTTLS（587）"/></ComboBox></StackPanel></Grid><TextBlock Text="收件联系人 · 每行一个邮箱，全部发送" FontSize="11" Foreground="#68717D" Margin="0,4,0,6"/><TextBox x:Name="MailContacts" AcceptsReturn="True" Height="70" Padding="10,8" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><TextBlock Text="保存后 Alt+7 直接截取所有显示器并发送 PNG 附件，截图会自动保存到本地目录。" TextWrapping="Wrap" FontSize="11" Foreground="#7A838F" Margin="0,10,0,0"/></StackPanel>
<StackPanel x:Name="ShotsPage" Visibility="Collapsed"><TextBlock Text="本地截图目录" FontSize="11" Foreground="#68717D" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ShotDirectory"/><Button x:Name="BrowseShotDirectory" Grid.Column="1" Content="选择目录" Margin="10,0,0,0"/></Grid><TextBlock Text="修改目录后点击保存。所有完成的截图都会保存为 PNG，包括识别和邮件截图。" TextWrapping="Wrap" Foreground="#7A838F" FontSize="11" Margin="0,12,0,24"/><StackPanel Orientation="Horizontal"><Button x:Name="StartShot" Content="开始截图" Background="#002FA7" Foreground="White" BorderBrush="#002FA7"/><Button x:Name="OpenShotHistory" Content="浏览历史截图" Margin="12,0,0,0"/><Button x:Name="StartRecord" Content="屏幕录制" Margin="12,0,0,0"/></StackPanel><Border BorderBrush="#E3E6EB" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,24,0,0"><StackPanel><TextBlock Text="截图与贴图操作" FontWeight="Bold" FontSize="15" Margin="0,0,0,14"/><TextBlock x:Name="ShotShortcutHint" TextWrapping="Wrap" Foreground="#68717D" FontSize="12" LineHeight="22" Margin="0,0,0,14"/>
<TextBlock Text="标注与编辑" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/><TextBlock Text="矩形、圆形、箭头、画笔、文字和打码；滚轮调整线条粗细或字号。&#10;Ctrl+Z 撤销 · Ctrl+Y 重做 · Ctrl+C 复制 · Ctrl+P 贴图" TextWrapping="Wrap" Foreground="#68717D" FontSize="12" LineHeight="22" Margin="0,0,0,14"/>
<TextBlock Text="滚动长截图" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/><TextBlock Text="框选后，在工具栏选择向上或向下滚动，自动拼接长图。&#10;到达边界自动完成；Enter 提前完成，Esc 取消。" TextWrapping="Wrap" Foreground="#68717D" FontSize="12" LineHeight="22" Margin="0,0,0,14"/>
<TextBlock Text="识别与翻译" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/><TextBlock Text="工具栏可直接识别文字、翻译选区；更多菜单中可解释名词、总结、提取表格或识别二维码。" TextWrapping="Wrap" Foreground="#68717D" FontSize="12" LineHeight="22" Margin="0,0,0,14"/>
<TextBlock Text="历史与贴图" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/><TextBlock Text="工具栏左右箭头或键盘 ← / → 切换历史，切换前自动保存标注。&#10;贴图支持拖动、滚轮缩放、Ctrl+滚轮调透明度；双击继续标注，Esc 关闭。" TextWrapping="Wrap" Foreground="#68717D" FontSize="12" LineHeight="22" Margin="0,0,0,14"/>
<TextBlock Text="屏幕录制" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/><TextBlock x:Name="RecordingShortcutHint" TextWrapping="Wrap" Foreground="#68717D" FontSize="12" LineHeight="22"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="PreferencesPage" Visibility="Collapsed">
      <TextBlock Text="翻译目标语言" FontSize="11" Foreground="#68717D" Margin="0,0,0,8"/><ComboBox x:Name="TargetLanguage" IsEditable="True" Padding="10,8" Background="#F7F7F8" BorderBrush="#E3E6EB" BorderThickness="1" Margin="0,0,0,24"/>
      <Border BorderBrush="#E3E6EB" BorderThickness="0,1,0,1" Padding="0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="完成提示音" FontWeight="Bold"/><TextBlock Text="成功复制或生成结果后轻响，失败时不响。" FontSize="11" Foreground="#7A838F" Margin="0,7,0,0"/></StackPanel><CheckBox x:Name="CompletionSound" Style="{StaticResource Switch}" Grid.Column="1" VerticalAlignment="Center"/></Grid></Border>
      <Border BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" Padding="0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开机自启" FontWeight="Bold"/><TextBlock Text="登录 Windows 后静默运行，在托盘待命。" FontSize="11" Foreground="#7A838F" Margin="0,7,0,0"/></StackPanel><CheckBox x:Name="AutoStart" Style="{StaticResource Switch}" Grid.Column="1" VerticalAlignment="Center"/></Grid></Border>
      <Border BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" Padding="0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="恢复默认快捷键" FontWeight="Bold"/><TextBlock Text="恢复为 Alt + ~ 录屏、Alt + 1 截图，Alt + 2 至 Alt + 9 执行识别与邮件操作。" FontSize="11" Foreground="#7A838F" Margin="0,7,0,0"/></StackPanel><Button x:Name="Restore" Grid.Column="1" Content="恢复" Padding="14,8"/></Grid></Border>
     </StackPanel>
    </Grid></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" ClipToBounds="True"><TextBlock x:Name="StatusText" Text="就绪" Foreground="#68717D" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="Esc 取消框选 · 关闭后留在托盘" FontSize="10" Foreground="#969EA8" Margin="0,7,0,0"/></StackPanel><Button x:Name="Save" Grid.Column="1" Content="保存设置" Background="#002FA7" BorderBrush="#002FA7" Foreground="White" Padding="20,12" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid>
   </Grid>
  </Grid>
 </Grid></Border>
</UserControl>
