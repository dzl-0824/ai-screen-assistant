      <Border BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" Padding="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource LineIcon}" Data="M12,1 C26,1 26,23 12,23 C-2,23 -2,1 12,1 Z M12,6 L12,7 M12,11 L12,18" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="名词解释" FontWeight="Bold" FontSize="14"/><TextBlock Text="理解术语，附简短示例" FontSize="11" Foreground="#7A838F" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="Key2" Grid.Column="2" Style="{StaticResource Key}"/><Button x:Name="Run2" Visibility="Collapsed" Grid.Column="3" Style="{StaticResource Run}" Content="框选"/></Grid></Border>
      <Border BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" Padding="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource LineIcon}" Data="M3,1 L16,1 L21,6 L21,23 L3,23 Z M15,1 L15,7 L21,7 M7,11 L17,11 M7,15 L17,15 M7,19 L13,19" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="内容总结" FontWeight="Bold" FontSize="14"/><TextBlock Text="提炼关键内容与结论" FontSize="11" Foreground="#7A838F" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="Key3" Grid.Column="2" Style="{StaticResource Key}"/><Button x:Name="Run3" Visibility="Collapsed" Grid.Column="3" Style="{StaticResource Run}" Content="框选"/></Grid></Border>
      <Border BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" Padding="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource LineIcon}" Data="M1,2 L23,2 L23,22 L1,22 Z M1,8 L23,8 M1,15 L23,15 M9,2 L9,22" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="表格提取" FontWeight="Bold" FontSize="14"/><TextBlock Text="还原行列，复制到 Excel" FontSize="11" Foreground="#7A838F" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="Key4" Grid.Column="2" Style="{StaticResource Key}"/><Button x:Name="Run4" Visibility="Collapsed" Grid.Column="3" Style="{StaticResource Run}" Content="框选"/></Grid></Border>
      <Border BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" Padding="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource LineIcon}" Data="M1,1 L9,1 L9,9 L1,9 Z M15,1 L23,1 L23,9 L15,9 Z M1,15 L9,15 L9,23 L1,23 Z M15,15 L19,15 L19,19 L23,19 L23,23 M15,19 L15,23" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="二维码识别" FontWeight="Bold" FontSize="14"/><TextBlock Text="本地解码，无需网络" FontSize="11" Foreground="#7A838F" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="Key5" Grid.Column="2" Style="{StaticResource Key}"/><Button x:Name="Run5" Visibility="Collapsed" Grid.Column="3" Style="{StaticResource Run}" Content="框选"/></Grid></Border>
      <Border BorderBrush="#E3E6EB" BorderThickness="0,1,0,1" Padding="0,7" Background="Transparent" CornerRadius="6" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource LineIcon}" Data="M2,8 L2,2 L8,2 M16,2 L22,2 L22,8 M22,16 L22,22 L16,22 M8,22 L2,22 L2,16 M7,9 L17,9 M7,14 L14,14" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="全屏发邮件" FontWeight="Bold" FontSize="14"/><TextBlock Text="截取全屏，发送给配置联系人" FontSize="11" Foreground="#7A838F" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="Key7" Grid.Column="2" Style="{StaticResource Key}"/><Button x:Name="Run7" Visibility="Collapsed" Grid.Column="3" Style="{StaticResource Run}" Content="智能框选"/></Grid></Border>
     </StackPanel>
     <StackPanel x:Name="ConnectionPage" Visibility="Collapsed">
