      <Border BorderBrush="#E3E6EB" BorderThickness="0,1,0,1" Padding="0,7" Background="#E8EDF9" CornerRadius="6" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource LineIcon}" Data="M2,8 L2,2 L8,2 M16,2 L22,2 L22,8 M22,16 L22,22 L16,22 M8,22 L2,22 L2,16 M7,9 L17,9 M7,14 L14,14" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="智能识别" FontWeight="Bold" FontSize="14"/><TextBlock Text="自动判断用途，外文优先翻译" FontSize="11" Foreground="#7A838F" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="Key6" Grid.Column="2" Style="{StaticResource Key}"/><Button x:Name="Run6" Visibility="Collapsed" Grid.Column="3" Style="{StaticResource Run}" Content="智能框选"/></Grid></Border>
