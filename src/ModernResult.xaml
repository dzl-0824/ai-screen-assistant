<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Arial, Microsoft YaHei UI" FontSize="13" Foreground="#19212B" Background="#F7F7F8">
 <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E6EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F7F7F8"/><Setter Property="Foreground" Value="#68717D"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="12,12"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E3E6EB"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8EDF9"/><Setter Property="Foreground" Value="#19212B"/></Trigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Border BorderBrush="#DEE2E8" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent"><TextBlock x:Name="WindowTitle" Text="AI截图助手" Margin="18,0,0,0" FontSize="11" Foreground="#7A838F" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Min" Width="42" Margin="0" Padding="12,10" BorderThickness="0" Background="Transparent"><Path Data="M0,4 L12,4" Stroke="#68717D" StrokeThickness="1.3"/></Button><Button x:Name="Close" Width="42" Margin="0" Padding="12,10" BorderThickness="0" Background="Transparent"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#68717D" StrokeThickness="1.3"/></Button></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="28,14,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
   <StackPanel><TextBlock x:Name="ResultTitle" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="Description" Foreground="#7A838F" FontSize="12" Margin="0,10,0,0"/><StackPanel x:Name="SmartBar" Visibility="Collapsed" Orientation="Horizontal" Margin="0,10,0,10"><ComboBox x:Name="SmartMode" Width="130" Padding="8,4"/><Button x:Name="ChangeMode" Content="切换处理" Padding="10,4" Margin="8,0,0,0"/></StackPanel><Border Height="18"/></StackPanel>
   <Border Grid.Row="1" Background="White" BorderBrush="#E3E6EB" BorderThickness="1" CornerRadius="6" Padding="20"><Grid><TextBox x:Name="OutputText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontFamily="Arial, Microsoft YaHei UI" FontSize="14" Foreground="#19212B" Text="正在读取截图并生成结果…"/><DataGrid x:Name="OutputTable" Visibility="Collapsed" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#F7F7F8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3E6EB" ColumnWidth="*" MinColumnWidth="110" FontSize="13"/></Grid></Border>
   <Grid Grid.Row="2" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" Text="正在生成…" Foreground="#7A838F" FontSize="11"/><TextBlock x:Name="Hint" Text="关闭窗口可取消" Foreground="#969EA8" FontSize="10" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="Retry" Content="取消生成"/><Button x:Name="OpenUrl" Content="打开网址" Visibility="Collapsed"/><Button x:Name="Export" IsEnabled="False" Content="导出文本"/><Button x:Name="Copy" IsEnabled="False" Content="复制结果" Background="#002FA7" BorderBrush="#002FA7" Foreground="White" Margin="0"/></StackPanel></Grid>
  </Grid>
 </Grid></Border>
</UserControl>
